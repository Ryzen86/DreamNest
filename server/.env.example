# Use 3002 if another app already listens on 3001 (e.g. Docker containers)
PORT=3002
MONGO_URI=mongodb://127.0.0.1:27017/dreamnest
# Required when NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_string
# Comma-separated allowed frontend origins for CORS
CLIENT_URL=http://localhost:3000
# NODE_ENV=production

# Razorpay (INR) — get test keys from https://dashboard.razorpay.com/
# Leave empty to use demo payment gateway locally
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed to allow demo payments when NODE_ENV=production and keys are empty
PAYMENT_DEMO_MODE=false

# Amazon S3 (profile + listing images)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
